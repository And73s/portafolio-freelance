---
import Layout from '../../layouts/Layout.astro';
import Lab from '../../components/Lab.astro';
import { translations, type Locale } from '../../i18n';
import {profile} from '../../data/config';
export function getStaticPaths(){return [{params:{lang:'es'}},{params:{lang:'en'}}];}
const lang=Astro.params.lang as Locale; const t=translations[lang];
---
<Layout lang={lang}>
  <section class="hero container"><div class="row align-items-center g-5"><div class="col-lg-8"><p class="eyebrow"><span class="blue-line"/>{t.eyebrow}</p><h1>{t.hero}<br/><span>{t.heroAccent}</span></h1><p class="hero-intro">{t.intro}</p><div class="d-flex gap-3 flex-wrap hero-actions"><a href="#projects" class="button-primary">{t.explore} <span>↗</span></a><a href="#contact" class="button-secondary">{t.quote} <span>→</span></a></div></div><div class="col-lg-4"><div class="process-illustration"><div class="diagram-top"><span>{t.diagramLabel}</span><span>01—03</span></div><div class="source-files"><span>CSV</span><span>SQL</span><span>API</span></div><p>{t.diagram[0]}</p><div class="connector"/><div class="transform"><span aria-hidden="true">[ &nbsp; / &nbsp; ]</span><p>{t.diagram[1]}</p></div><div class="connector"/><div class="output"><div class="mini-bars" aria-hidden="true">{[35,55,43,76,63,92,82].map(h=><i style={`height:${h}%`}/>)}</div><p>{t.diagram[2]}</p></div><p class="diagram-note">{t.diagramNote}</p></div></div></div><div class="hero-bottom"><span>{t.role}</span><span>Python <b>/</b> Django <b>/</b> SQL <b>/</b> JavaScript</span>{profile.available && <span>{t.available}</span>}</div></section>
  <section id="services" class="section container"><div class="row g-5"><div class="col-lg-5"><p class="eyebrow">01 / {t.nav[0]}</p><h2>{t.serviceTitle}</h2><p class="section-intro">{t.serviceIntro}</p></div><div class="col-lg-7 service-list">{t.services.map((s,i)=><article class="service"><span class="index">0{i+1}</span><div><h3>{s[0]}</h3><p class="service-problem">{s[1]}</p><p>{s[2]}</p></div><span class="service-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
  <section id="projects" class="section projects-section"><div class="container"><div class="section-heading"><p class="eyebrow">02 / {t.nav[1]}</p><h2>{t.projectTitle}</h2><p>{t.projectIntro}</p></div>{t.projects.map((p,i)=><article class:list={['project-feature',`project-${i}`]}><div class="project-visual" aria-hidden="true">{i===0?<div class="monitor-art"><div class="mock-top">{lang === 'es' ? 'OPERACIÓN / 01' : 'OPERATIONS / 01'}<span>● ● ●</span></div><div class="mock-metrics"><span>128<small>{lang === 'es' ? 'UNIDADES' : 'UNITS'}</small></span><span>84<small>{lang === 'es' ? 'PEDIDOS' : 'ORDERS'}</small></span><span>06<small>{lang === 'es' ? 'LÍNEAS' : 'LINES'}</small></span></div><svg viewBox="0 0 400 120" fill="none"><path d="M0 100H400M0 60H400M0 20H400" stroke="currentColor" opacity=".15"/><path d="M0 96L35 82L70 90L105 45L140 58L175 36L210 52L245 18L280 30L315 12L350 22L400 5" stroke="#90b6ff" stroke-width="3"/></svg><div class="mock-bottom">{lang === 'es' ? 'SIMULACIÓN' : 'SIMULATION'} <span>{lang === 'es' ? 'DATOS LOCALES' : 'LOCAL DATA'}</span></div></div>:i===1?<div class="report-art"><div>report_01.csv <span>↘</span></div><div>report_02.xlsx <span>→</span></div><div class="clean-file">dataset.csv <span>✓</span></div><p>{lang === 'es' ? 'IMPORTAR → VALIDAR → EXPORTAR' : 'IMPORT → VALIDATE → EXPORT'}</p></div>:<div class="order-art"><span>{lang === 'es' ? 'PEDIDO / DEMO-001' : 'ORDER / DEMO-001'}</span><div><i>01</i><b>{lang === 'es' ? 'PRODUCTO' : 'PRODUCT'}</b><span>✓</span></div><div><i>02</i><b>{lang === 'es' ? 'CARRITO' : 'CART'}</b><span>✓</span></div><div><i>03</i><b>{lang === 'es' ? 'CONFIRMAR' : 'CONFIRM'}</b><span>→</span></div></div>}</div><div class="project-copy"><p class="eyebrow">0{i+1} / {t.demoLabel}</p><h3>{p[0]}</h3><p class="project-subtitle">{p[1]}</p><p>{p[2]}</p><p class="tech-stack">{p[3]}</p><a href="#lab" data-demo-link={i} class="text-button">{t.tryDemo} ↗</a></div></article>)}</div></section>
  <Lab lang={lang}/>
  <section id="about" class="section container"><div class="row g-5"><div class="col-lg-4"><p class="eyebrow">04 / {t.nav[3]}</p><div class="monogram" aria-hidden="true">am<span>/</span></div><p class="about-name">Carlos Andrés<br/>Martínez Portillo</p><p>{t.role}</p></div><div class="col-lg-8"><h2>{t.aboutTitle}</h2><p class="about-copy">{t.about}</p><p class="about-note">{t.aboutNote}</p><div class="skills">{['Python','Django','Django REST Framework','Django Channels','WebSockets','SQL','pandas','Power Query','VBA','OpenCV','Git & GitHub','Bootstrap','Chart.js'].map(s=><span>{s}</span>)}</div></div></div></section>
  <section class="section process-section"><div class="container"><p class="eyebrow">05 / {lang==='es'?'PROCESO':'PROCESS'}</p><h2>{t.processTitle}</h2><div class="row g-4 steps">{t.steps.map((s,i)=><div class="col-md-6 col-lg-3"><span>0{i+1}</span><h3>{s[0]}</h3><p>{s[1]}</p></div>)}</div><p class="small-note">{t.written}</p></div></section>
  <section id="contact" class="section container"><div class="row g-5"><div class="col-lg-5"><p class="eyebrow">06 / {t.nav[4]}</p><h2>{t.contactTitle}</h2><p>{t.contactIntro}</p><div class="social-links">{Object.entries(profile.social).filter(([,url])=>url).map(([name,url])=><a href={url} rel="noopener noreferrer" target="_blank">{name} ↗</a>)}{!Object.values(profile.social).some(Boolean)&&<p class="small-note">{t.source}</p>}</div></div><div class="col-lg-7"><form id="contact-form" data-email={profile.email} data-locale={lang}><div class="row g-4"><div class="col-sm-6"><label for="name">{t.fields[0]}</label><input id="name" name="name" autocomplete="name" required maxlength="100"/></div><div class="col-sm-6"><label for="email">{t.fields[1]}</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"/></div><div class="col-12"><label for="service">{t.fields[2]}</label><select id="service" name="service" required><option value="">{t.select}</option>{t.services.map(s=><option>{s[0]}</option>)}</select></div><div class="col-12"><label for="description">{t.fields[3]}</label><textarea id="description" name="description" required minlength="20" maxlength="3000" rows="4"/></div><div class="col-12"><label for="budget">{t.fields[4]}</label><input id="budget" name="budget" maxlength="100"/></div></div><p class="small-note mt-4">{t.mailHelp}</p>{!profile.email&&<p class="config-note">{t.unconfigured}</p>}<button type="submit" class="button-primary" disabled={!profile.email}>{t.prepare} ↗</button><p id="contact-status" role="status"/></form></div></div></section>
</Layout>
<script>
import {translations, type Locale} from '../../i18n';
const form=document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity()||!form.dataset.email)return; const data=new FormData(form);const t=translations[form.dataset.locale as Locale];const body=['name','email','service','description','budget'].map((key,i)=>`${t.fields[i]}: ${data.get(key)}`).join('\n\n');window.location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('service')))}&body=${encodeURIComponent(body)}`;document.querySelector('#contact-status')!.textContent=t.prepared;});
</script>

